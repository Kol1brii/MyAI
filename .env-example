# В данном примере используется провайдер openrouter, если у вас есть VPN и вы планируете использовать провайдера groq.com,
# то раскомментируйте строку ниже:
# AI_BASE_URL=https://api.groq.com/openai/v1

# Также в случае использования этого провайдера, не забудьте раскомментировать строки для заполнения таблицы, моделями от groq.com [См. app.scripts.seed_models.py]

AI_BASE_URL=https://openrouter.ai/api/v1

# Для получения API ключа, перейдите на сайт ниже:
# https://openrouter.ai/workspaces/default/keys
# https://groq.com/

AI_API_KEY=

DATABASE_URL=postgresql+asyncpg://postgres:admin@db:5432/postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgres

# Секрет для подписи JWT. Значение ниже подходит для локального запуска как есть,
# для продакшена сгенерируйте своё: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
